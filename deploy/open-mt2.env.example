# open-mt2 runtime configuration
#
# Installed to /etc/open-mt2/open-mt2.env and read by the systemd units
# (EnvironmentFile=) and, as a fallback, by the servers themselves.
# Lines starting with # are comments; quote values that contain spaces.

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------
# AUTH_SERVER_ADDRESS / GAME_SERVER_ADDRESS are the LOCAL BIND address.
# Use 0.0.0.0 to accept connections from the LAN — the stock client connects
# from another machine, so 127.0.0.1 only works for a client on this host.
AUTH_SERVER_ADDRESS=0.0.0.0
AUTH_SERVER_PORT=11002

GAME_SERVER_ADDRESS=0.0.0.0
GAME_SERVER_PORT=13001

# REAL_SERVER_ADDRESS is the address the auth handshake hands to the client, so
# it must be the IPv4 the client can actually reach (your LAN address), not the
# bind address above. It has to be a dotted-quad IPv4 literal: hostnames are not
# resolved. Leave it empty only if the servers bind on a directly reachable
# address.
REAL_SERVER_ADDRESS=

# ---------------------------------------------------------------------------
# Database (MariaDB / MySQL)
# ---------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=openmt2
DB_ROOT_PASSWORD=
AUTH_DB_DATABASE_NAME=auth
GAME_DB_DATABASE_NAME=game

# Password of the seeded admin account created by the migration
# (login: admin). Change it, then re-run the migration or update the row.
SEED_ADMIN_PASSWORD=admin

# ---------------------------------------------------------------------------
# Cache (Redis)
# ---------------------------------------------------------------------------
CACHE_HOST=127.0.0.1
CACHE_PORT=6379
# Keepalive ping interval in milliseconds.
CACHE_PING_INTERVAL=10000

# ---------------------------------------------------------------------------
# Process tuning
# ---------------------------------------------------------------------------
# error | warn | info | debug. Use info or warn on a small board: debug logs every
# packet and will fill the journal.
LOG_LEVEL=info

# Directory for the rotating log files written by the winston adapter.
# Must be writable by the service user; install.sh creates and owns it.
LOG_DIR=/var/log/open-mt2

# Node.js heap limit in MB. open-mt2 is memory light; on a 1 GB board keep this
# below what the rest of the system needs (MariaDB and Redis run on the same
# device).
NODE_OPTIONS=--max-old-space-size=512