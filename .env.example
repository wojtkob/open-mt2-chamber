# open-mt2 configuration
#
# Copy to .env for development (`npm run dev:auth` / `npm run dev:game`), or to
# /etc/open-mt2/open-mt2.env for a packaged install (see deploy/open-mt2.env.example
# for the annotated production template).

# Local bind address. Use 0.0.0.0 to accept clients from the LAN; 127.0.0.1 only
# works when the game client runs on the same machine.
AUTH_SERVER_PORT=11002
AUTH_SERVER_ADDRESS=127.0.0.1
GAME_SERVER_PORT=13001
GAME_SERVER_ADDRESS=127.0.0.1

# Address the login handshake hands to the client, as a dotted-quad IPv4.
# Must be reachable from the client machine; falls back to SERVER_ADDRESS.
REAL_SERVER_ADDRESS=

LOG_LEVEL=debug

# Directory for the winston log files. Defaults to ./logs when unset.
# LOG_DIR=logs

DB_PORT=3306
DB_HOST=127.0.0.1
DB_ROOT_PASSWORD=123456
SEED_ADMIN_PASSWORD=admin
AUTH_DB_DATABASE_NAME=auth
GAME_DB_DATABASE_NAME=game
DB_USER=root

CACHE_PORT=6379
CACHE_HOST=127.0.0.1
# Redis keepalive ping interval, in milliseconds.
CACHE_PING_INTERVAL=10000