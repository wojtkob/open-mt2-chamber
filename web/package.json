{
    "name": "open-mt2-web-client",
    "version": "1.0.0",
    "private": true,
    "description": "Visual client for the open-mt2 server: React SPA that talks to the game/auth servers through the web client bridge.",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -p tsconfig.json && vite build",
        "preview": "vite preview",
        "typecheck": "tsc -p tsconfig.json",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "open-mt2": "file:..",
        "react": "^19.3.0",
        "react-dom": "^19.3.0"
    },
    "devDependencies": {
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/node": "^25.9.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "jsdom": "^30.1.2",
        "typescript": "~6.0.3",
        "vite": "^8.3.4",
        "vitest": "^5.0.3"
    }
}
